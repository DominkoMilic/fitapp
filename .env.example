# Copy to .env.local (git-ignored) and fill in.
# All EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project (Dashboard → Project Settings → API).
# Local CLI stack: URL is http://127.0.0.1:54321 (use your machine's LAN IP on a physical device),
# key is printed by `npx supabase start` / `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable / anon key only. NEVER the service_role / secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Version of the legal documents users accept during onboarding (stored in `consents`).
EXPO_PUBLIC_LEGAL_VERSION=2026-11-08
