# Copy to .env.local (git-ignored) and fill in.
# All EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project (Dashboard → Project Settings → API).
# Local CLI stack: URL is http://127.0.0.1:55321 (use your machine's LAN IP on a physical device),
# key is printed by `npx supabase start` / `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable / anon key only. NEVER the service_role / secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Version of the legal documents users accept during onboarding (stored in `consents`).
EXPO_PUBLIC_LEGAL_VERSION=2026-11-09

# Support / privacy contact shown in the app's legal pages. Required for production builds.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional, build time only (read by app.config.ts, not bundled as EXPO_PUBLIC_*).
# Google Maps SDK for Android key, restricted to the app's package name and signing certificate.
# Without it, Android draws the route as a shape instead of on a map. iOS uses Apple Maps (no key).
GOOGLE_MAPS_ANDROID_API_KEY=
